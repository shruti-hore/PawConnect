# Database
DATABASE_URL=postgresql+psycopg2://DB_USER:DB_PASSWORD@RDS_ENDPOINT:5432/DB_NAME?sslmode=require

# Application
APP_ENV=production
SECRET_KEY=
WEB_CONCURRENCY=2
HTTP_PORT=80

# AWS General & S3
AWS_REGION=
S3_BUCKET_NAME=

# Amazon Cognito Authentication
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
# Optional override for testing/mocking JWKS:
# COGNITO_JWKS_URL=

# Logging
LOG_LEVEL=INFO